// 00 00 17 00 00 16 00 00 00 00 00 00


byte unknown_setting_8DA[9]<bgcolor=cRed>;
// after setting to 123456789, the default settings on individual profile were reset.
// Of this list of 9 bytes, only the 2nd and 3rd byte have data
// is filled with  0, 1, 2, 5 or 6.
// Possibly some kind of long press default value?
// todo: test changing the values:
// 0
// 1
// 2
// 5
// 6

short mode_light_on[12]<bgcolor=cGreen, name=getModeButtonLightState>; 
// 00 = off
// 01 = on
// 02 = blink 
// 03 = ?
// 05 = ?
// 06 = Tiguan knob lit.

// the following 8 groups of data map perfectly to the controls.
// it is the value range that is used when communicating to the control module.
// These bytes actually control what is happening when a certain mode is chosen
// You can diplay these as a matrix
BitfieldRightToLeft();

struct{
    struct{
        int request_value_A     :4;
        int request_value_B     :4;
    }request_value[30]<optimize=true>;
} request_values[8]<bgcolor=cGreen,optimize=true>;

// This is a matrix of 8 bytes x 30 controls.
// Each byte holds 2 profiles (4 bit per profile)
// The value is sent to the control module, which changes it's behavior to a given mode when it's supported.
// The values correspond with the request value that can be found in
// measurements values, driving profile selection, requested value.
// If a Requested Value leads to a change in Actual Value, it means the module accepts this value.

byte list_of_controls[30]<bgcolor=cGreen, comment=getControlName >;
// This determines what FPA-control is controled by the bytes at "settings_shown_in_HMI"
// usage: set each byte to whatever FPA-control you would like to be handles by the "settings_shown_in_HMI". This should be in line with FPA_controls
// NEVER PUT FF HERE

byte grouped_controls[30] <bgcolor=cDkGreen>;
// this byte range determines to which group a control belongs.

long grouped_controls_controlbyte <bgcolor=cDkGreen, fgcolor=cLtGreen,format=binary>;
// works as follows:
// 1 grouped setting:  01 (Bit 0 set)
// 2 grouped settings: 03 (Bit 0-1 set)
// 3 grouped settings: 07 (Bit 0-2 set)
// 4 grouped settings: 0F (Bit 0-3 set)
// 5 grouped settings: 1F (Bit 0-4 set)
// 6 grouped settings: 3F (Bit 0-5 set)
// 7 grouped settings: 7F (Bit 0-6 set)

byte gw_longcoding_controls_with_links[30]<bgcolor=cGreen, name=getLongCodingByteName>;
// Byte 9, Bit 0 = 0x19 = EDS and so forth
// Byte 9, Bit 1 = 0x1A = HHC
// see getLongCodingByteName

byte gw_longcoding_controls_without_links[30]<bgcolor=cDkGreen, name=getLongCodingByteName>;
// Same list as previous one, but can be used to link one control to another.  Is used with Sailing and 4x4 features.

// SettingBytes_again[30] @ 0xA67 — legacy name (kept for backward compat with
// older .bt versions). Semantically: per-control platform/variant flag,
// possible meaning "control category" (value 2 vs 3).
// Empirical clusters (see Research-stuff Printf for full mapping):
//   3 — most controls on standard FPA datasets (~85%)
//   2 — powertrain controls (Engine/StartStop/Gearbox) on some datasets
//   2 — ALL active controls on Leon FR/Cupra series (combined with _more=8)
//   0 — only when slot is unused (control_id == 0)
// .bt author tested values experimentally: no observable HMI/ECU behaviour
// change, so likely a vestigial field consumed only by old firmware.
byte SettingBytes_again[30] <bgcolor=cRed>;
// SettingBytes_more[30] @ 0xA85 — legacy name. Companion to SettingBytes_again
// (same per-control variant-flag role).
// Empirical clusters:
//   0 — almost all controls on every dataset
//   8 — set for active controls in Leon FR/Cupra series (LA/LE/LG/LI/LK/LO)
//       and (rarely) in Tiguan PHEV — coincides with feature_flags @ 0x8C0 = 0
//       (pre/no-FPA platform marker).
byte SettingBytes_more[30] <bgcolor=cDkRed>;
//
// and SettingBytes_again/_more follow the (3,0)/(2,0) clustering instead.
// This raises the possibility that the combination "_again==2 AND _more==8
// as previously assumed, but rather a positive R/Cupra-performance-hardware
// flag written by the factory flashing tool (these platforms have unique
// DCC/torque-vectoring hardware that could plausibly need a distinct
// low-level marker independent of whether FPA itself is enabled).
// Caveats / why this is still just a hypothesis (~30% confidence):
//   - unknown_8C0==0 alone is also seen on some genuinely non-FPA legacy
//     datasets, so 0x8C0 in isolation is NOT a reliable R-vehicle signal.
//   - No non-R Cupra/Leon (i.e. same chassis, standard trim) dataset has
//     been compared yet to falsify this — that comparison would be the next
//     step to confirm whether the signature tracks the R/Cupra badge
//     specifically, or just "FPA absent/disabled" more generally.
//   - Sample size is small (LA/LE/LG/LI/LK/LO + rare Tiguan PHEV outlier).
// TODO: diff against a standard (non-R) Leon/Cupra-chassis dataset with FPA
// enabled to see whether _again/_more/0x8C0 revert to the standard clusters.

// the following data all seems to be related to PHEV.
struct{
    // the following data appears to be related to Hybrid only, as it's almost completely empty on non-hybrid/PHEV datasets.
    ubyte PHEV_unknown_AA3[8] <bgcolor=cLtRed>;
    // KV, N1, N8:      00 01 02 03 04 00 00 01
    // others:          00 32 33 34 00 00 00 01
    
    ubyte PHEV_unknown_AA9[4] <bgcolor=cRed>;
    // known decimal values:
    // 255, 255, 255, 255 on most datasets
    // 255, 6    255, 255 on PD, PF, PH and PO 
    // 255, 8    241, 241 on O2, O3, O4, O5, ON, OO, OV, P2, P3, P4, PG, PJ, PK, PL, TE
    
    ubyte PHEV_unknown_AAF[4] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0xFF
    
    ubyte PHEV_unknown_AB3[4] <bgcolor=cDkRed>;
    // known decimal values:
    // 5	241	1	255
    // 5	241	241	255
    // 255	255	4	241
    // 255	255	255	255
    
    ubyte PHEV_unknown_AB7[5] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0xFF
    ubyte PHEV_unknown_ABC <bgcolor=cDkRed>; // always 0xFF, except on MZ: 5
    ubyte PHEV_unknown_ABD[9] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0xFF
    ubyte PHEV_unknown_AC6[26] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0x00
    ubyte PHEV_unknown_AE0[14] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0xFF
    ubyte PHEV_unknown_AEE[14] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always: 00 FF 00 00 FF FF FF FF FF FF FF 00 00 00
    
    // note: there are quite a few 14-sized shapes in this area...
    
    // SPECULATION (~50% confidence): three fields together match the Java
    // `HybridTargetRangeSerializer` wire layout — int16(maxRange) +
    // int16(currentRange) + int32(rangeUnit). Only MZ00 has non-zero values
    // (8/8/8) so n=1 — cannot distinguish from 3 separate ushorts. Keep as
    // ushorts pending more PHEV examples; field names provisional.
    ushort PHEV_unknown_AFC <bgcolor=cDkRed, comment="Hyp. HybridTargetRange.maxRange (int16)">;   // always 0 0, except on MZ: 8 0
    ushort PHEV_unknown_AFE <bgcolor=cRed, comment="Hyp. HybridTargetRange.currentRange (int16)">; // always 0 0, except on MZ: 8 0
    ushort PHEV_unknown_B00 <bgcolor=cDkRed, comment="Hyp. HybridTargetRange.rangeUnit low word (int32 spans B00..B03)">; // always 0 0, except on MZ: 8 0
    ubyte PHEV_unknown_B02[5] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_B08[4] <bgcolor=cDkRed>; // always 255 255, 255, 255, except on MZ: 255, 12, 12, 12
    ubyte PHEV_unknown_B0C[4] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0xFF
    ubyte PHEV_unknown_B0F[77] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // 77 bytes of FF's and 00's. What's the relevance? No idea!
    
    ushort PHEV_unknown_B5C[20] <bgcolor=cDkRed>;    // see excelsheet
    ubyte PHEV_unknown_B83[44] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0x00
    ubyte PHEV_unknown_BB0[10] <bgcolor=cDkRed>;     // see excelsheet
    ushort PHEV_unknown_BBA[10] <bgcolor=cLtRed>;    // see excelsheet
    ubyte PHEV_unknown_BCE[10] <bgcolor=cDkRed>;     // see excelsheet

    // SPECULATION (~45% confidence — raised from 40% in r10006 after deeper
    // pair-pattern analysis):
    //
    // Four 32-byte rows form a structured lookup table of (X, Y) pairs +
    // trailing zeros. Each row's pair-count appears to live at byte 10.
    // Rows differ by *content type*, not by repetition:
    //
    //   PHEV mainstream cluster (15 datasets:
    //     O2/O3/O4/O5/ON/OO/OV/P2/P3/P4/PG/PJ/PK/PL/TE):
    //     row 0: [9, 22, 9, 21, 9, 23, 9, 20,  0, 0, 4, ...]
    //            -> 4 pairs (9, banner_id) where banner_id ∈ {20,21,22,23}
    //               = AID-banner enum "Driving/Hybrid Mode unable/not available"
    //               => row 0 = "which AID banner to show when state 9 is denied"
    //     row 1: [1, 2, 1, 1, 1, 1, 1, 1,     0, 0, 3, ...]
    //            -> 4 pairs of mode-ids (1=Comfort, 2=Normal) — transition map
    //     row 2: [2, 1, 1, 1, 1, 5, 1, 8,     0, 0, 2, ...]
    //     row 3: [2, 4, 1, 2, 1, 5, 1, 8,     0, 0, 2, ...]
    //            -> mode-id pairs, different per row (possibly per-mode rules)
    //
    //   Audi cluster (KV00 / N100 / N800):
    //     row 0: [22, 0, 5, 0, 5, 28, 5, 28,  0, 9, 0, ...]
    //            -> different pair shape; banner-id 28 = GTE Logo
    //
    //   Arteon R cluster (PD00 / PH00 / PO00 / PF00):
    //     row 0: [20, 20, 0, ...] — minimal (1 pair)
    //     row 1: [2, 2, 0, ...]
    //     row 2: [1, 7, 0, ...]
    //     row 3: [5, 9, 0, ...] (Arteon R) or [5, 15, 0, ...] (Tiguan R PF00)
    //            -> profile-id pairs (5=Eco, 7=Individual, 9=Lift, 15=EVOff)
    //
    // Best guess: 4 rows = 4 transition-table types
    //   row 0: state -> AID-banner mapping
    //   rows 1-3: mode-id transition rules for different conditions
    //
    // RA0..RA7Serializer hypothesis ruled out — those are charging-timer DTOs
    // (pos + profileOperation + maxCurrent + chargeLevels + ...), unrelated.
    // Byte-10 hypothesis as length-prefix is consistent (P300 has [4,3,2,2]
    // matching distinct pair counts when counted by *unique non-trivial pairs*).
    struct {
        ubyte PHEV_unknown_BD8_table_1[32] <bgcolor=cRed, comment="Hyp. (mode_id, aid_banner_id)*4 + tail">;
        ubyte PHEV_unknown_BD8_table_2[32] <bgcolor=cDkRed, comment="Hyp. transition/priority row 2">;
        ubyte PHEV_unknown_BD8_table_3[32] <bgcolor=cRed, comment="Hyp. transition/priority row 3">;
        ubyte PHEV_unknown_BD8_table_4[32] <bgcolor=cDkRed, comment="Hyp. transition/priority row 4">;
    } PHEV_unknown_BD8_table;
    
    ubyte PHEV_unknown_C58[22] <bgcolor=cLtRed>;     // see excelsheet
    
    
    ubyte PHEV_unknown_C6E[107] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>;     // see excelsheet
    ubyte PHEV_unknown_CD9[1] <bgcolor=cRed>;
    // known decimal values:
    // 0 : almost always
    // 80: N1, N8, KV (Audi datasets)
    // 42: O2, O3, O4, O5, ON, OO, OV, P2, P3, P4, PG, PJ, PK, PL, TE
    ubyte PHEV_unknown_CDA[3] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_CDD[4] <bgcolor=cRed>;
    // known decimal values:
    // 0    0 0   0   : almost always
    // 134  0 12  0   : KV, N1, N8 (Audi datasets)
    // 34   0 28  0   : MZ
    // 34   0 28  27  : O2, O3, O4, O5, ON, OO, OV, P2, P3, P4, PG, PJ, PK, PL, TE   

    ubyte PHEV_unknown_CE1[11] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    // SPECULATION (~75% confidence — strongest of the PHEV-region hypotheses):
    // Maps to Java `BatteryControlProfileOperationSerializer` (8-bit bitmask):
    //   bit 0: charge
    //   bit 1: climate
    //   bit 2: climateWithoutExternalSupply
    //   bit 3: autoDefrost
    //   bit 4: seatHeaterFrontLeft
    //   bit 5: seatHeaterFrontRight
    //   bit 6: seatHeaterRearLeft
    //   bit 7: seatHeaterRearRight
    // Observed: 0 (none), 1 (charge only — full EVs e-Golf/O400/O500), 5
    // (bits 0+2 = charge + climateWithoutExternalSupply — all mainstream PHEVs:
    // Magotan/Tiguan/Passat/Arteon/Tarraco GTE). Alternative ChargeMode-enum
    // interpretation (5=DC+CONDITIONING) ruled out because PHEVs are AC-only.
    ubyte PHEV_unknown_CEC[1] <bgcolor=cRed, comment="Hyp. BatteryControl ProfileOperation 8-bit mask (charge|climate*|seat*)">;
    // known decimal values:
    // 0    
    // 1:   O4, O5, P2
    // 5:   O2, O3, ON, OO, OV, P3, P4, PG, PJ, PK, PL, TE

    ubyte PHEV_unknown_CED[9] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_CF6[1] <bgcolor=cRed>;
    // known decimal values:
    // 0    
    // 1: O2, O3, O4, O5, ON, OO, P2, P3, P4, PG, PJ, PK, PL, TE

    ubyte PHEV_unknown_CF7[11] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_D02[10] <bgcolor=cRed>;
    // known decimal values:
    // 15	0	0	0	30	0	0	1	0	0   KV, N1, N8 (Audi datasets)
    // 31	0	0	0	62	0	0	1	0	0   MZ, O2, O3, O4, O5, ON, OO, OV, P2, P3, P4, PG, PJ, PK, PL, TE

    // hybrid_modes (0xD0C) — 12-byte CharismaOperationMode structure, confirmed
    // across 69 PHEV .fpa datasets (confidence 97%):
    //   bytes 0-5  : mode slot values — one CharismaOperationMode per slot
    //                (0-6 per getHybridModeName(), plus observed unknowns
    //                55/57; 0xFF = slot disabled/unused).
    //   bytes 6-11 : activation flags for the corresponding slot in bytes 0-5
    //                (0x02 = enabled, 0xFF = disabled, 0x00 = unused).
    //
    // Confirmed patterns across the dataset corpus:
    //   default (45 files): 00 00 00 00 00 00 ff ff ff ff ff ff
    //   active   (6 files): 01 05 02 00 06 37 ff ff ff ff ff ff
    //                        (EV, SOC, Sustaining, -, HybridSport, Unknown55)
    //   other    (6 files): 01 03 02 04 06 00 ff ff ff ff ff ff
    //
    // Source: cross-checked against TE00, P300, P400, PG00, O200, MZ00, KV00,
    // N100, plus mk8 PHEV (LP04, LP05, LPH1, 2031, 2059). Java DSi DTO
    // CharismaOperationMode anchors the value semantics.
    //
    // NOTE: this region only carries meaningful data in mk7 (FileSize 4352)
    // PHEV / Audi datasets. mk8 (4088) tooling ignores it even when stray
    // bytes happen to look PHEV-shaped.
    ubyte hybrid_modes[12]        <format=decimal,bgcolor=cYellow, comment=getHybridModeName>;
    ubyte hybrid_modes_active[12] <bgcolor=cRed>;
    // hybrid_modes_active companion byte. Semantics still under research —
    // observed values: 0..4 mixed with stride-2 zeros (e.g. P300 [1,0,0,1,0,2,
    // 0,3,0,4,0,2]). Preserve verbatim on save.
    
    // SPECULATION (~35% confidence): 192 bytes = 12 records of 16 bytes each.
    // Per-record structure observed across PHEV datasets:
    //   chunk[0] header pattern (P300/TE00/MZ00):
    //     [0,0,0, 32, 0, 5, 2, 0, 1, 0, 5, 0, 3, 0, 0, 255]
    //   - byte 3 (32), byte 8 (1), byte 12 (3) appear constant per platform
    //   - byte 5 (5/10), byte 6 (2/250), byte 10 (5/1) vary by platform
    //   - byte 15 = 0xFF = consistent end-of-record marker
    // Plausibly 12 hybrid-mode-slots × 16-byte BatteryControl record. Field
    // semantics unknown without RA-serializer cross-reference. Bytes preserved
    // verbatim by all known tooling.
    ubyte PHEV_unknown_D24[192] <bgcolor=cDkRed, comment="Hyp. 12 hybrid-slot records × 16 bytes (end-marker 0xFF at byte15)">;

    // SPECULATION (~55% confidence): 12-byte lookup table holding an FPA
    // profile-id per internal slot. Values fit dict_profiles namespace (1..15)
    // — NOT the smaller CharismaProfilesSerializer enum (max 12).
    //
    // Empirically TWO templates exist:
    //   * 16 datasets: (6, 5, 1, 4, 1, 3, 2, 1, 1, 14, 13, 1)  older GTE-era
    //   * 15 datasets: (6, 5, 1, 4, 1, 3, 2, 1, 1,  6,  5, 1)  newer GTE-era
    //
    // Difference at positions 9,10:
    //   14/13 = HybridArea / HybridCharge  (older PHEV firmware only)
    //   6/5   = Race / Eco                  (newer firmware — generic fallback)
    // Strongly suggests a firmware-generation marker: newer firmware moved
    // hybrid-only profile-ids out of these slots so the same table layout works
    // on non-PHEV cars.
    //
    // Tried mapping the 12 slots against the CharismaViewOptions field order
    // (profileComfort, profileAutoNormal, profileDynamic, profileOffroad,
    //  profileEfficiency, profileRaceSport, profileIndividual, profileRange,
    //  profileLift, profileOffroadLevel2/3/4): the resulting per-slot semantic
    // (e.g. slot 0 "Comfort" -> profile-id 6 "Race") makes no sense, so the
    // 12 DE4 slots are NOT in CharismaViewOptions display order. Per-slot
    // semantic still unknown.
    ubyte PHEV_unknown_DE4[12] <bgcolor=cLtRed, comment="Hyp. hybrid-slot to profile-id default lookup">;
    // on cars with a hybrid profile, this is always:
    // 6 5 1 4 1 3 2 1 1 14 13 1   (older template)
    // 6 5 1 4 1 3 2 1 1  6  5 1   (newer template — 2022+)
    // otherwise it's zeroes.

    ubyte PHEV_unknown_DF0[6] <bgcolor=cRed>;
    // zeroes, but on MZ it's 0 0 3 0 0 0 

    ubyte PHEV_unknown_DF6[28] <bgcolor=cDkRed>;

    ubyte PHEV_unknown_E12[4] <bgcolor=cRed>;
    // zeroes, but on MZ it's 3 0 0 0 

    ubyte PHEV_unknown_E16[14] <bgcolor=cLtRed>;

    ubyte PHEV_unknown_E24[8] <bgcolor=cRed>;

    struct{
        ubyte PHEV_unknown_E2C_data[6];
    }   PHEV_unknown_E2C[5] <bgcolor=cDkRed>;


    ubyte PHEV_unknown_E4A[4] <bgcolor=cRed>;
    ubyte PHEV_unknown_E4F[8] <bgcolor=cLtRed>; // 2 0 0 0 0 0 0 0  on MZ, 0 on all others
    ubyte PHEV_unknown_E56[64] <bgcolor=cRed>; // looks to be 8x8 bytes or so
    // SPECULATION (~30% confidence): 7-byte config block with byte 5 always
    // 0xAE (174) as constant marker. Four templates observed:
    //   * [138, 37, 1, 34, 0, 174, 0] — 16x mainstream PHEV
    //   * [130, 36, 5, 34, 0, 174, 0] — 14x newer PHEV
    //   * [  0,  0, 0,  0, 0, 174, 0] —  3x edge cases
    //   * [130, 36, 1, 34, 0, 174, 0] —  1x
    // Bytes 0..2 vary by template; bytes 3=34, 4=0, 5=174, 6=0 mostly constant.
    // No Java mapping yet identified. Preserve verbatim.
    ubyte PHEV_unknown_E96[7] <bgcolor=cDkRed, comment="Hyp. config block (byte5=0xAE marker)">; // on Hybrid cars: 138 37 1 34 0 174 0
    // AID_mode_banner (0xE9D) — AID banner per hybrid-mode SLOT (NOT per FPA
    // profile slot). Index aligns with hybrid_modes[] above; profiles_aid_banner
    // at 0x8C2 is the per-profile equivalent. Like hybrid_modes, this region is
    // mk7-PHEV-only in practice.
    ubyte AID_mode_banner[12]<bgcolor=cGreen, comment=getAIDBanner>;
    ubyte PHEV_unknown_EA9[20] <bgcolor=cDkRed>; // on Hybrid cars: 138 37 1 34 0 174 0 
    ubyte PHEV_unknown_E4D[4] <bgcolor=cRed>;
    ubyte PHEV_unknown_EC1[10] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ushort PHEV_unknown_ECB[4] <bgcolor=cRed>;
    ubyte PHEV_unknown_ED3[4] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_ED7[4] <bgcolor=cDkRed>;
    // especially the 4th byte has a lot of variation and is set on most datasets
    // very interesting what this could be!
    ubyte PHEV_unknown_EDB[24] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_EF3[1] <bgcolor=cRed>;
    // always 0, except on O2, O3, O4, O5, ON, OO, OV, P2, P3, P4, PG, PJ, PK, PL, PM, TE. There it's 21
    ubyte PHEV_unknown_EF4[4] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_EF8[1] <bgcolor=cRed>; // 1 on KV, otherwise 0
    ubyte PHEV_unknown_EF9[7] <bgcolor=cDkGray, fgcolor=cGray, hidden=true>; // always 0
    ubyte PHEV_unknown_F00[1] <bgcolor=cRed >;
    // 0 : almost always
    // KV: 8
    
    ubyte PHEV_unknown_F01[24] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_F19[2] <bgcolor=cRed >;
    // 0 0: almost always
    // KV: 127 255
    
    FSeek(3867);
    ubyte PHEV_unknown_F1B[15] <bgcolor=cDkGray, fgcolor=cGray , hidden=true>; // always 0
    ubyte PHEV_unknown_F1D[2] <bgcolor=cRed >;
    // 0 0: almost always
    // 6 0: on PD, PH, PO
    // 0 6: on PF
} PHEV_unknown_data <fgcolor=cLtBlue>;


if (mk7) {
    FSeek(0xf2c);
    ubyte PHEV_zeroes[464]<bgcolor=cDkGray, fgcolor=cGray , hidden=true>;   // all zeroes on all datasets I've seen
    LittleEndian(); // go to littleendian mode because of checksum format

}       
    FSeek(FileSize()-4);
    
    local int calculated_checksum;
    calculated_checksum = Checksum(CHECKSUM_CRC32, 0,FileSize()-4);
    ulong dataset_checksum       <format=hex,bgcolor=cGreen,comment="CRC32">;


FSeek(2006);
ubyte button_for_test[32];





// Don't mess with anything below here, unless you know what you're doing.

