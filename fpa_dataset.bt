//--------------------------------------
//--- 010 Editor Binary Template
//
// File:        fpa_dataset.bt
// Author:      MQB-coding
// Revision:    10007
// Purpose:     VAG MQB FPA (fahrprofilauswahl / driving profile) dataset parsing
// Comments:    red = unknown, yellow = possible, green = sure, gray = doesn't look very relevant.
//              Currently only useful for FPA datasets for 3Q0907530Q and newer.
//
// Reference:   DSI firmware constants from dsi.debuginfo.B3.24.1.MIB_DSI3_2019_KW39-319.39.0.xml
//              - CharismaProfiles: 19 driving profiles (1-19, plus 255=NOPROFILE_INIT)
//              - CharismaFunctions: 59 control functions (1-59, plus 255=NONE)
//              - CharismaOperationMode: 6 hybrid modes (EV, Hybrid, Sustaining, Charging, SOC Control, Hybrid Sport)
//              - CharismaSystemType: 3 system types (FPA=0, Freewheel=1, DCC=2)
//              - CharismaContent: 10 UI screen types (Profile/DCC/Hybrid/Offroad/etc.)
//
// Changes vs r10006:
//   - PHEV_unknown_BD8_table comment expanded with deeper per-row analysis:
//     row 0 = (state, AID-banner) pairs (banner-IDs 20..23 = "unavailable"
//     set); rows 1-3 = mode-id transition pairs; pair-count probably at byte 10.
//     RA0..RA7 wire-format ruled out (those are charging-timer DTOs, not
//     state-transitions). Confidence raised to ~45%.
//   - PHEV_unknown_DE4 comment expanded with the CharismaViewOptions
//     display-order test: 12 DE4 slots do NOT map to CharismaViewOptions
//     profile field order (semantically nonsensical), so per-slot meaning
//     remains unknown. Confidence stays ~55% (still a profile-id default
//     lookup, just unknown which slot represents what).
//
// Changes vs r10005:
//   - "Dataset specifics" Printf: now opens with a compact 12-slot profile
//     summary table (slot/id/name/return/banner/LED) for quick at-a-glance scan,
//     followed by the per-profile detailed setting blocks.
//   - "HMI" Printf BUG FIX: titles previously called getSettingName(slot+1) which
//     used the mode-id enum (Comfort/Normal/Sport...) and printed wrong per-slot
//     headers. Replaced with getFPAName(FPA_profile[slot]) — the actual profile
//     name from that slot. Also skips empty slots and added a header row.
//   - "Research" Printf split into two clearly-titled subsections:
//     unknown_setting_8DA + per-control variant flags (SettingBytes_again/_more).
//   - SettingBytes_again[30] and SettingBytes_more[30] declarations now have
//     header comments documenting the empirical clusters we discovered
//     (legacy names kept for backward compat; semantics now spelled out).
//   - unknown_value_32C, profile_0_nodata get clarifying header comments.
//   - Removed duplicate ushort parses of allow/remember regions
//     (`function_bytes_settings_shifted_by_1_bit` + `function_bytes_settings`).
//     Printf now reads the BE u16 directly via ReadUByte()<<8|ReadUByte().
//   - New "PHEV region map" Printf section before Checksum: one-line overview of
//     every annotated PHEV-region byte range with name, hypothesis label, and
//     confidence level. Compact research overview.
//
// Changes vs r10004:
//   - "Request values (0x8FB)" and "Sub-control request-value overrides (0x26)"
//     Printf sections merged into one combined "Request values + sub-control
//     overrides" table. Each main control row is followed by indented sub-control
//     rows (prefixed `>`) for grouped controls — mirrors how the Python app_fpa
//     UI renders the nested layout. Sub rows leave column 0 blank (no override
//     for mode-id 0). Single header + legend at top, no separate title block.
//
// Changes vs r10003:
//   - "Allowed to change in specific mode (0x296)" + "Remember setting after
//     car restart (0x2D2)" Printf sections rewritten. Old version used ASCII
//     "┐│" arrow art over 16 column header lines that misaligned with the
//     IntToBinaryStr-rendered body, was nearly unreadable. New version uses a
//     fixed-width column-per-bit grid (X/.) with a bit-to-profile legend at
//     top, mirrors how the Python app_fpa renders the checkbox grid. New
//     helper `printBitmaskRow()` shared between both sections.
//
// Changes vs r10002:
//   - "Request values (0x8FB)" Printf rewritten. Old version used
//     `request_values_0..7` paired-column headers that misaligned with the
//     16-column body and included confusing labels ("00 cmft(1) nrml(2) ...").
//     New version: clean fixed-width columns (3-char per mode-id), proper
//     header row separator, mode-id legend at top, one row per active
//     control with the 16 nibble values inline.
//
// Changes vs r10001:
//   - groupMemberMatrixPosition() rewritten: now uses "count earlier positions
//     belonging to the SAME group" algorithm (mirrors Python app_fpa parser).
//     Previous "max-group-seen" tracking only worked for monotone group layouts
//     and broke on non-monotone layouts like LPM0 [1,1,1,4,4,3,2,2,5,6,6].
//     The hack `if (group==4) group=3;` is removed.
//   - Setting-Groups Printf callsite now uses group_member_request_values_controls[g-1]
//     (the authoritative group-header field @0x206), not list_of_grouped_controls[g-?]
//     with a special case for group 4.
//   - "Sub-control request-value overrides" Printf section: re-enabled (was
//     commented out) and rewritten to iterate per-sub-control rather than per
//     physical matrix row. Mirrors Python app_fpa's child_entries rendering —
//     prints sub-control name + 15 profile values per row, much more readable.
//
// Changes vs r10000:
//   - Annotated several PHEV-region unknowns with hypothesised semantics derived
//     from MIB infotainment Java decompile (DSi serializers under
//     de/esolutions/fw/comm/dsi/carhybrid/ + cardrivingcharacteristics/).
//     All annotations are SPECULATIVE — confidence levels marked per field.
//     No byte layout changes; only comments. See per-field SPECULATION notes.
//
// Changes vs r9999:
//   - control_is_allowed_to_change (0x296) bit-field relabeled. New mapping:
//       u16 bit N = FPA profile-id (N + 1). Old labels were off-by-one for
//       decls 0..9 (high byte + first two low-byte fields).
//   - control_is_reset (0x2D2) bit-field: decl 8 renamed from "ecoplus" to
//       "id7_individual" (rest already matched u16 bit N = profile-id N).
//   - hybrid_modes (0xD0C) annotated with getHybridModeName + slot-indexed
//       semantics note (NOT 1:1 with FPA_profile[12]).
//   - AID_mode_banner (0xE9D) annotated as slot-indexed (paired with hybrid_modes).
//   - getControlName extended with IDs 58..81 (mk8 / newer firmwares).
//   - getHybridModeName helper added (CharismaOperationMode mapping).
//--------------------------------------
OutputPaneClear();
local int groupsMatrixControlsArray[64];

local int mk7 = (FileSize() == 0x1100 ? 1 : 0);

BitfieldDisablePadding();
BigEndian();
char dataset_version[4]       <format=hex,bgcolor=cGreen,comment="Version">; // something like J1 00
// Anything older than version IA seems to be a different format.
// second part of the version is always 00

//ubyte header1[10] <bgcolor=cRed>;
struct{
    byte header_04; // always 64
    byte year <read=Str("%lg", this+2010), bgcolor=cGreen>;
    byte header_06 <bgcolor=cDkGray>; // always 00
    byte header_07; // always 0a
    byte header_08; // 00 or 1e. Always 00, except with LA, LE, LG, LI, LK, LO
    byte header_09; // 1, 0 or ff. FF is used on Audi Datasets. 0 is used on the datasets that are marked "with eco button".
    byte header_0A; // 0, 1 or 6. 6 is used on the datasets that are marked "with eco button".
    byte header_0B; // 0, 3, 14, 32 or 0A . No idea what this is. 3 is used on the datasets that are marked "with eco button".
    byte header_0C; // 0A or 0F. 0A only seems to be used with Tiguan datasets?
    byte header_0D; // always 01
} header1;


struct{
    byte header_0E; //always F4
    byte header_0F; // 0, 2 or 6. 2 only used in NOFPA_DS JC00. 0 is used in the datasets that are marked by 1e in byte 8 of header1
    byte header_10 <bgcolor=cDkGray>; // always 00
    byte header_11 <bgcolor=cDkGray>; // always 00
    byte header_12; // 4 or 7. 4 is used in LA, LE, LG, LI, LK, LO, TA, TB, TC, TK.
    byte header_13; // 0, 2 or 4. Audi datasets use 0 or 4. 2 is used by all others.
    byte header_14; // 0, 1 or 2. 1 is used on the datasets that are marked "with eco button".
    byte header_15; // 0, 1 or 2
    byte header_16; // 0, 14 or 1e. Audi datasets use 0 or 1e.
    byte header_17 <bgcolor=cDkGray>; // always 0
} header2;


// From here it appears to be some kind of table, 32 rows, 15 colums, or something like that.
// it appears to override the request values before they are sent to a control module
FSeek(38);
struct{
    struct{
        ubyte value_B:4<bgcolor=cDkGreen>;
        ubyte value_A:4<bgcolor=cGreen>;
        }group_children_request_values_x [15]<optimize=true>;
}group_children_request_values[32]<optimize=true>;

// findings so far:
// on these datasets, the controls line up with their respective position in list_of_grouped_controls:
// IB (Golf 2019)
// J6 (Tiguan 2019)
// JA (Golf R 310)
// JD (Golf Standard)
// N1 (A3 tdi 2018)
// OC (Magotan 2021 with DCC Slider)
// OS (GTI 2021)
// OY


// looks like they match:
// M9 (Octavia 2019)
// MJ (Superb 2020)


// on these datasets, they don't:
// LI (Leon FR 2020)
// LK (Leon Cupra 300)
// LO (Leon Cupra)
// O2 (Magotan 2021 GTE)




FSeek(518);
ubyte group_member_request_values_controls[8] <bgcolor=cDkGreen,name=getControlName>;
ubyte amount_of_members_per_group[8] <bgcolor=cGreen>;


// these are the names of the groups.
// examples:

// IB   21 FF FF FF FF FF FF FF 04          - 1 group, 4 controls
// J6   21 FF FF FF FF FF FF FF 04          - 1 group, 4 controls
// JA   21 24 FF FF FF FF FF FF 03 02       - 2 groups, 3+2 controls
// JD   21 FF FF FF FF FF FF FF 04          - 1 group, 4 controls
// N1   03 0A FF FF FF FF FF FF 04 03       - 2 groups, 4 controls, 3 controls
// OC   21 24 FF FF FF FF FF FF 04 02       - 2 groups, 4 controls, 2 controls
// OS   21 FF FF FF FF FF FF FF 04          - 1 group, 4 controls
// OY   21 24 FF FF FF FF FF FF 04 02       - 2 groups, 4 + 2 controls

// LI   01 FF FF FF FF FF FF FF 05          - 1 group, 5 controls
// LK   01 FF FF FF FF FF FF FF 06          - 1 group, 6 controls
// LO   01 FF FF FF FF FF FF FF 07          - 1 group, 7 controls
// O2   00 FF FF FF FF FF FF FF FF          - no groups
// PF   21 24 07 FF FF FF FF FF 03 02 02    - 3 groups, 3+2+2 controls
// Having 3+2+2 in dataset PF rules out that this is anything other than group size.

ubyte reserved_for_future_use[32] <bgcolor=cDkGray, hidden=true>; // always zeroes
// these determine specifically which controls are set in the group member matrix.
long members_in_group_[4]<read=getGroupMemberLongCodingByteName, bgcolor=cGreen>;
// Known values:

// sets with 1 group
// IB:      4018 0000 0000 0000             1 group: 4 controls
// J6:      4018 0000 0000 0000             1 group: 4 controls
// JC:      1000 0010 0000 0000             1 group: 2 controls
// LI:      4018 0000 0000 0000             1 group: 7 controls   
// LK:      4018 0000 0000 0000             1 group: 6 controls
// OS:      4018 0000 0000 0000             1 group: 4 controls

// sets with 2 groups
// M9:      401C 0000 2001 0000             2 groups: 4 controls, 2 controls
// OC:      4018 0080 2000 0000             2 groups: 4 controls, 2 controls
// OY:      4018 0080 2000 0000             2 groups: 4 controls, 2 controls

// sets with 3 grOups
// PF:      4018 0080 2000 0000 0080        3 groups: 3 controls, 3 controls, 2 controls 

// sets without groups
// J4:      0000 0000 0000 0000
// KN:      0000 0000 0000 0000
// O2:      0000 0000 0000 0000
// O3:      0000 0000 0000 0000
// ON:      0000 0000 0000 0000
// OO:      0000 0000 0000 0000
// P4:      0000 0000 0000 0000

// Audi, so different logic:
// N1:      0010 0080 2001 0000

ubyte reserved_for_future_use_2[80] <bgcolor=cDkGray, hidden=true>; // always zeroes




// (Removed in r10006: previously declared a parallel `ushort
// function_bytes_settings_shifted_by_1_bit[30]` over the same bytes the
// allow-bitfield struct consumes, just to give Printf an easy ushort handle.
// Printf now uses ReadUShort(0x296 + i*2) directly — no second parse needed.)
FSeek(662);
// control_is_allowed_to_change (0x296) — 16-bit per control, big-endian.
//
// Empirically verified bit-mapping (cross-checked against JD00, KV00, OZ00,
// P300, TE00, J400, LP04, LPH1 + Java ASLCarFPA ordinal table):
//
//     u16 bit N = FPA profile-id (N + 1)
//
// So bit 0 = id 1 = Comfort, bit 6 = id 7 = Individual (NOT "Eco plus" as the
// older comments claimed — JD00 has no Eco+ profile yet sets bit 6 widely),
// bit 7 = id 8 = Range (J400 confirms — it's the only basic-tier dataset with
// FPA id 8 and matching bit 7), … bit 14 = id 15 = EV Off, bit 15 = id 16 =
// Drift / Torque Vectoring (triggers popup confirmation, not in onroad profiles).
// There is NO "notset / Profile 0" slot in this field — every bit represents a real profile.
//
// 010 Editor's default for BigEndian is BitfieldLeftToRight: first-declared
// field becomes the MSB of the first stored byte. With BE the first stored
// byte is the HIGH byte of the u16. So:
//   decl 0 -> u16 bit 15 -> id 16
//   decl 7 -> u16 bit  8 -> id  9
//   decl 8 -> u16 bit  7 -> id  8
//   decl 15-> u16 bit  0 -> id  1
// The labels below are renamed accordingly. Old labels (evoff/hybridarea/...)
// were off-by-one for the high byte (they assumed remember-style encoding).
struct {
    // HIGH byte → u16 bits 15..8 → profile-ids 16..9
    ubyte allowed_to_change_in_id16_second_hold:        1 <read = getYesNo>; // u16 bit 15
    ubyte allowed_to_change_in_id15_ev_off:             1 <read = getYesNo>; // u16 bit 14
    ubyte allowed_to_change_in_id14_hybrid_area:        1 <read = getYesNo>; // u16 bit 13
    ubyte allowed_to_change_in_id13_hybrid_charge:      1 <read = getYesNo>; // u16 bit 12
    ubyte allowed_to_change_in_id12_hybrid_hold:        1 <read = getYesNo>; // u16 bit 11
    ubyte allowed_to_change_in_id11_offroad_individual: 1 <read = getYesNo>; // u16 bit 10
    ubyte allowed_to_change_in_id10_snow:               1 <read = getYesNo>; // u16 bit  9
    ubyte allowed_to_change_in_id9_lift_phev2:          1 <read = getYesNo>; // u16 bit  8

    // LOW byte → u16 bits 7..0 → profile-ids 8..1
    ubyte allowed_to_change_in_id8_range_phev1:         1 <read = getYesNo>; // u16 bit  7
    ubyte allowed_to_change_in_id7_individual:          1 <read = getYesNo>; // u16 bit  6
    ubyte allowed_to_change_in_id6_race:                1 <read = getYesNo>; // u16 bit  5
    ubyte allowed_to_change_in_id5_eco:                 1 <read = getYesNo>; // u16 bit  4
    ubyte allowed_to_change_in_id4_offroad:             1 <read = getYesNo>; // u16 bit  3
    ubyte allowed_to_change_in_id3_sport:               1 <read = getYesNo>; // u16 bit  2
    ubyte allowed_to_change_in_id2_normal:              1 <read = getYesNo>; // u16 bit  1
    ubyte allowed_to_change_in_id1_comfort:             1 <read = getYesNo>; // u16 bit  0
    } control_is_allowed_to_change[30]               <bgcolor=cGreen,optimize=true>;
// (Removed in r10006: same dedup as the allow side — the parallel ushort
// declaration over the remember bytes is gone. Printf uses ReadUShort(0x2D2 + i*2).)
FSeek(722);
// control_is_reset (0x2D2) — 16-bit per control, big-endian.
//
// Empirically verified bit-mapping (same datasets as the allow field above):
//
//     u16 bit N = FPA profile-id N   (no +1 shift)
//
// So bit 0 = id 0 = "Profile 0" / notset, bit 1 = id 1 = Comfort, bit 7 = id 7
// = Individual (NOT "Eco plus" — JD00 DCC sets bits 1..3 = Comfort/Normal/
// Sport, which is the common DCC remember pattern), bit 15 = id 15 = EV Off.
// The 1-bit shift relative to the allow field comes from "notset" living at
// the LOW-byte LSB in remember vs sitting between the byte boundaries (and
// being meaningless) in allow.
//
// With BE + BitfieldLeftToRight: decl 0 -> u16 bit 15, decl 15 -> u16 bit 0.
// Only decl 8 ("ecoplus") was misnamed — it actually represents id 7 =
// Individual. Renamed below to match the empirical truth.
struct {
    // HIGH byte → u16 bits 15..8 → profile-ids 15..8
    ubyte remember_after_reset_in_id15_ev_off:             1 <read = getYesNo>; // u16 bit 15
    ubyte remember_after_reset_in_id14_hybrid_area:        1 <read = getYesNo>; // u16 bit 14
    ubyte remember_after_reset_in_id13_hybrid_charge:      1 <read = getYesNo>; // u16 bit 13
    ubyte remember_after_reset_in_id12_hybrid_hold:        1 <read = getYesNo>; // u16 bit 12
    ubyte remember_after_reset_in_id11_offroad_individual: 1 <read = getYesNo>; // u16 bit 11
    ubyte remember_after_reset_in_id10_snow:               1 <read = getYesNo>; // u16 bit 10
    ubyte remember_after_reset_in_id9_lift_phev2:          1 <read = getYesNo>; // u16 bit  9
    ubyte remember_after_reset_in_id8_range_phev1:         1 <read = getYesNo>; // u16 bit  8

    // LOW byte → u16 bits 7..0 → profile-ids 7..0
    ubyte remember_after_reset_in_id7_individual:          1 <read = getYesNo>; // u16 bit  7 (was "ecoplus")
    ubyte remember_after_reset_in_id6_race:                1 <read = getYesNo>; // u16 bit  6
    ubyte remember_after_reset_in_id5_eco:                 1 <read = getYesNo>; // u16 bit  5
    ubyte remember_after_reset_in_id4_offroad:             1 <read = getYesNo>; // u16 bit  4
    ubyte remember_after_reset_in_id3_sport:               1 <read = getYesNo>; // u16 bit  3
    ubyte remember_after_reset_in_id2_normal:              1 <read = getYesNo>; // u16 bit  2
    ubyte remember_after_reset_in_id1_comfort:             1 <read = getYesNo>; // u16 bit  1
    ubyte remember_after_reset_in_id0_notset:              1 <read = getYesNo>; // u16 bit  0

    }control_is_reset[30]               <bgcolor=cDkGreen,optimize=true>;

byte restart_value[30] <format=hex, bgcolor=cGreen, name=getSettingName>;
// this is the default value after restart  

// unknown_value_32C @ 0x32C — single byte. Empirically always 0 across all 99
// example datasets. .bt author tested non-zero values: no observable effect.
// Treated as reserved zero-padding.
byte unknown_value_32C <bgcolor=cDkGray,hidden=true>;


// enabled profiles start here
ubyte FPA_profile[12] <format=hex,bgcolor=cGreen,name=getFPAName>;
// Enabled FPA profile IDs by slot (0-11). Slot contains profile id or 0x00 (unused).
// Profile 0x10 (16 decimal) = Drift / Torque Vectoring — requires explicit popup
// confirmation before activation. Not included in onroad profile list.
// Changing slot value changes button shown in FPA selection screen.
// Example: Put "04" into profile_1 → displays as Offroad.

ubyte profile_returns_after_restart[12] <format=hex,bgcolor=cGreen, name=getFPAName>;
// This determines what profile position it returns to after restarting the car.

struct{
    ubyte allow_return_to_evoff: 1             <read = getYesNo>;
    ubyte allow_return_to_hybridarea: 1        <read = getYesNo>;
    ubyte allow_return_to_hybridcharge: 1      <read = getYesNo>;
    ubyte allow_return_to_hybridhold: 1        <read = getYesNo>;
    ubyte allow_return_to_offroadindividual: 1 <read = getYesNo>;
    ubyte allow_return_to_snow: 1              <read = getYesNo>;
    ubyte allow_return_to_lift: 1              <read = getYesNo>;
    ubyte allow_return_to_clubsport: 1         <read = getYesNo>;

    ubyte allow_return_to_individual: 1        <read = getYesNo>;
    ubyte allow_return_to_race: 1              <read = getYesNo>;
    ubyte allow_return_to_eco: 1               <read = getYesNo>;       
    ubyte allow_return_to_offroad: 1           <read = getYesNo>;
    ubyte allow_return_to_sport: 1             <read = getYesNo>;
    ubyte allow_return_to_normal: 1            <read = getYesNo>;
    ubyte allow_return_to_comfort: 1           <read = getYesNo>;
	ubyte allow_return_to_notset: 1            <read = getYesNo>;   

} allow_return_to_profile <optimize=false, bgcolor=cGreen>;
// this determines whether or not it's allowed to return to a given profile upon reset.

// profile_0_nodata[30] @ 0x347 — 30 bytes that look like they should hold
// "profile 0" (notset) per-control settings, but empirically always 0.
// .bt author tested non-zero values: no observable effect. Likely reserved.
byte profile_0_nodata[30] <bgcolor=cDkGray, hidden=true>;


struct{
    // refer to FPA_controls for the meaning of each byte number
    byte setting_byte[30] <bgcolor=cDkGreen, comment=getSettingName, open=true, format=hex>;
}profile[12];
// the driving profiles as they are displayed underneath the (i) icon in the HMI.



byte list_of_grouped_controls[30]<format=hex,bgcolor=cGreen, name=getControlName>; 
// The value of this determines what value is used in the profiles for instance, 
// if there's a value 01 on the first position, that means the first value in the 
// profile sets this specific setting.
// This list is what's actually shown in the User Interface, and it can represent a group of controls.
// See list_of_controls for all the ungrouped controls
// NEVER PUT FF HERE
struct{
    // this block consists of 30 bytes, after that the same pattern can be found, once for each enabled profile.
    // so there will be data for profile 1, 2, 3, but the 4th set of data here will be filled with zeroes when it's not used.
    // the 6th profile is used as "individual", so it has additional settings.
    ushort individual_setting_byte[30] <comment=getIndividualSettingName,open=true, bgcolor=cDkGreen> ;
    // Special constant: 0xFFFE (65534 decimal) does NOT decode as a bitmask of
    // mode flags (see getIndividualSettingName) — it is a sentinel meaning
    // "continuous DCC slider" (i.e. the HMI shows a Comfort<->Sport slider for
    // the Damper/DCC control instead of a fixed discrete mode).
} settings_shown_in_HMI[12];

// button section starts here
byte unknown_7BB[2] <bgcolor=cRed>; 
// almost always 00 00 , except on KV, N1, N8: Audi firmwares.
// there it's 00 FF

ubyte button_type[5] <bgcolor=cDkGreen>;
// 0 = disabled
// 1 = push button
// 4 = ?
// 5 = knob
// 6 = ? O(occurs on MZ)
// 254 = steering wheel long push   11111110
// 253 = steering normal push       11111101
// FD  on Tiguan R (has enabled steering wheel FPA buttons)
// FE  on Tiguan R (has enabled steering wheel FPA buttons)

ubyte button_behavior[5] <bgcolor=cYellow>;
// 0 = disabled
// 1 = enabled
// 4 = can rotate in 2 directions?
// there are 5 bytes, because there's room for 5 buttons.
// TODO: test other values

 
byte button_action[5] <bgcolor=cDkYellow>;
// 01 = button press cycles through the modes
// 03 = only open FPA dialog, no selection by button
// 05 = ? (occurs on MZ00)
// TODO: test other values like 2, 4, 5, 6.



byte cycling_through_modes[5] <bgcolor=cGreen>;
// 00 = nothing 
// 01 = there's no loop
// 03 = loop through all the modes over and over again
// again, for each of the 4 buttons.


ubyte button_profile_list_number[5]<bgcolor=cDkGreen >;
// the number determines the list of profiles to cycle through


struct {
    ubyte list_0_unknown_property: 4;
    ubyte list_0:4 <bgcolor=cLtGreen, name=(this == 0 ? "None" : getFPAName(FPA_profile[this-1]))>;
    
    ubyte list_1_unknown_property: 4;
    ubyte list_1:4 <bgcolor=cGreen, name=(this == 0 ? "None" : getFPAName(FPA_profile[this-1]))>;
    
    ubyte list_2_unknown_property: 4;
    ubyte list_2:4 <bgcolor=cGreen, name=(this == 0 ? "None" : getFPAName(FPA_profile[this-1]))>;
    
    ubyte list_3_unknown_property: 4;
    ubyte list_3:4 <bgcolor=cDkGreen, name=(this == 0 ? "None" : getFPAName(FPA_profile[this-1]))>;
} button_profile_lists[8] <optimize=true>;


// these 8 sets of 4 hold the 8 profiles you can choose from, depending on what list is selected by button_profile_list_number
// the numbers in this list refer to the entry in FPA_profile[12], so the possible (decimal) values are as follows:
// 0 = disabled
// 1 to 12 = reference to the profile in FPA_profile
// 221: ?
// 232: ?
// 241: seen on steering wheel button setups
// The logic for these higher numbers isn't clear yet.
// These values are highly probable to be split bytes.
// Todo: find out that's the logic behind this.

    struct {
    // the following need more research.
    ubyte unknown_button_data_7F6[4] <bgcolor=cYellow>;
    // known (dec) values:
    // 0
    // 1
    // 2
    // 5
    // 3rd and 4th are always 00
    
