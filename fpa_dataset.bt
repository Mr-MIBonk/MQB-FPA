    switch (value) {
    case 0x00: return "No";
    case 0x01: return "Yes";
    }
}

// helper function to print nice titles without needing to type them manually each time
void printTitle( string title )
    {
    Printf(" \n\n");
    Printf(" #################################################\n");
    Printf(" %s\n", title);
    Printf(" #################################################\n");
    }

// helper to print a per-control row of a 16-bit profile bitmask with one column
// per bit. X = bit set, . = bit clear. Used by Allow (0x296) and Remember (0x2D2)
// Printf sections.
void printBitmaskRow(int rowIndex, int controlId, int bitmask) {
    Printf("  %2d  %-30s %3d  |", rowIndex, getControlName(controlId), controlId);
    local int bit_;
    for (bit_ = 0; bit_ < 16; bit_++) {
        if (bitmask & (1 << bit_)) {
            Printf("  X");
        } else {
            Printf("  .");
        }
    }
    Printf("  | 0x%04x\n", bitmask & 0xFFFF);
}

// groupMemberMatrixPosition — maps a sub-control's position in list_of_controls[30]
// to the matrix-line index (0..63) inside group_children_request_values[32][15].
//
// Previously this used "max group seen so far" tracking which only works for
// monotone group layouts (e.g. OC's [1,1,1,1,2,2,...]) and BROKE on non-monotone
// layouts like LPM0's [1,1,1,4,4,3,2,2,5,6,6]. The hack `if (group==4) group=3;`
// was a partial patch for that bug.
//
// Correct algorithm (mirrors the Python app_fpa parser): "count earlier
// positions belonging to the SAME group" — works for any layout.
//
// Matrix-line formula: line = factor*16 + sub_order + 2*(group-1)
// where (factor, sub_order) come from how many earlier positions share this group.
int groupMemberMatrixPosition(int value, int group) {
    if (group < 1 || group > 8) return -1;
    local int order = 0;
    local int i_;
    for (i_ = 0; i_ < value; i_++) {
        if (grouped_controls[i_] == group) order++;
    }
    local int factor = 0;
    if (order < 2) {
        factor = 0;
    } else if (order < 4) {
        factor = 1;
        order = order - 2;
    } else if (order < 6) {
        factor = 2;
        order = order - 4;
    } else if (order < 8) {
        factor = 3;
        order = order - 6;
    } else {
        factor = 0; // orders >= 8 fall back to factor 0
    }
    order = (factor * 16) + order + (2 * (group - 1));
    groupsMatrixControlsArray[order] = value;
    return order;
}

